# Temurin 21 on UBI9; multiarch tag pinned to the inspected manifest digest.
FROM eclipse-temurin:21-jre-ubi9-minimal@sha256:70748205477fa77709402d365d202f1ec93a9c3104f88e574d1ae22c1f4cdc83
WORKDIR /catalog
WORKDIR /work
COPY --chown=1001:0 build/quarkus-app/ /work/quarkus-app/
ENV CATALOG_XTF_LOCATION=file:/catalog/catalog.xtf
EXPOSE 8080
USER 1001:0
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70.0", "-XX:-UsePerfData", "-jar", "/work/quarkus-app/quarkus-run.jar"]
