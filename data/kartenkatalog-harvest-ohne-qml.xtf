        <k:title>Hangneigung digitales Terrainmodell (2014)</k:title>
        <k:description>Auf Basis des DTM (Rasterdaten) wurde die Hangneigung in der Auflösung 50 cm abgeleitet. Die Neigung ist in Grad angegeben.</k:description>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="e7962518-4d1a-5f77-86bd-24263489551b">
