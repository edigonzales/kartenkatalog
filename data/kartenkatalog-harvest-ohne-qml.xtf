        <k:dtype>datasetview</k:dtype>
        <k:description>Gebiet, in dem die Nummerierung der Grundstücke eindeutig ist.
Bei Gemeindefusionen werden die Grundbücher nicht zusammengelegt, sie bleiben in den Ortsteilen bestehen.</k:description>
        <k:title>Grundbuchkreise</k:title>
        <k:ident_part>ch.so.agi.av.grundbuchkreise</k:ident_part>
        <k:transparency>0</k:transparency>
        <k:theme_title>Administrative Einteilung AV und Grundbuch</k:theme_title>
        <k:theme_ident>harvest-administrative-einteilung-av-und-grundbuch</k:theme_ident>
        <k:Thema_R ili:ref="1b51519c-50fa-5360-8856-81c9a4d022c7" />
