      <k:Ebene ili:tid="5550c05f-f502-57b6-83a4-fd0e7289fc65">
        <k:id>445d9e97-9998-554e-8995-4a1998462629</k:id>
        <k:dtype>datasetview</k:dtype>
        <k:description>Basislayer zur Ausscheidung von pflanzenbaulich nutzbarem Land (GELAN: LAND). Die Differenz zur Gesamtfläche ist den bestockten Flächen ohne landwirtschaftliche Hecken (GELAN: WALD) und unproduktiven und nicht humusierten Flächen (GELAN: UNPROD) zuzuordnen. Im MGDM Bund wird dieses Thema als "Permieter LN und Sömmerung" bezeichnet.</k:description>
        <k:title>Perimeter Landwirtschaftliche Nutzfläche und Sömmerung</k:title>
        <k:ident_part>ch.so.alw.landwirtschaft_tierhaltung.ln_soemmerung</k:ident_part>
