        <k:id>980199f6-c0b3-5e4f-abca-019095e37d51</k:id>
        <k:dtype>datasetview</k:dtype>
        <k:description>Beobachtete und vermutete tektonische Strukturen: Verwerfungen (Brüche), Überschiebungen, Synklinal- und Antiklinalachsen.</k:description>
