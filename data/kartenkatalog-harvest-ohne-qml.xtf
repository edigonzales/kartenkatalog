      <k:Ebene ili:tid="af41db6f-668d-5653-9a80-1af043df8ef9">
        <k:id>038ef12a-1e59-52d8-b313-a4d3a48d2c35</k:id>
        <k:dtype>datasetview</k:dtype>
        <k:description>Farbiges Satellitenbild (Satellit Worldview 3) der Region Thal. Die Pixelgrösse in Natura beträgt 30 cm.
Aufnahmedaten: 10. und 16. April 2015.</k:description>
        <k:title>Satellitenbild Thal (April 2014)</k:title>
        <k:ident_part>ch.so.agi.satellitenbild_thal_2014</k:ident_part>
        <k:transparency>0</k:transparency>
