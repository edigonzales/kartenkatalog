        <k:theme_ident>harvest-geologie</k:theme_ident>
        <k:Thema_R ili:ref="7df5fff7-0d6e-582e-a6b9-8f23b210d591" />
        <k:org_name>Amt für Umwelt</k:org_name>
      </k:Ebene>
      <k:Ebene ili:tid="c9b615a7-4369-56ed-b31f-2b795e4102d2">
        <k:id>a6d4b8a2-f6e0-591f-945b-c7f068eb55da</k:id>
        <k:dtype>datasetview</k:dtype>
        <k:description>Punktbezogene, aber für ihre Umgebung repräsentative Messungen des Einfallens geologischer Schichten, angegeben mit den Werten für Richtung (Azimut) und Betrag des Einfallens.</k:description>
        <k:title>Schichtfallen (Geologie)</k:title>
