      <k:Thema ili:tid="4f1ad009-af59-5503-8dcd-c355dc7b3bf5">
        <k:identifier>harvest-bodeneinheiten-bodenkartierung</k:identifier>
        <k:title>Bodeneinheiten Bodenkartierung</k:title>
        <k:description>Daten der kantonalen Bodenkartierung</k:description>
