      </k:Thema>
      <k:Thema ili:tid="96635199-d23e-566d-8031-ff2481e3d59c">
        <k:identifier>harvest-fliessgewaesser</k:identifier>
        <k:title>Fliessgewässer</k:title>
        <k:description>Umfasst die Fliessgewässer und stehenden Gewässer im Kanton Solothurn.</k:description>
        <k:data_owner>Amt für Umwelt</k:data_owner>
        <k:contact>mailto:afu@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="3fc60331-838d-5d6e-98a7-264fb18b03ee">
        <k:identifier>harvest-forstkreise-und-forstreviere</k:identifier>
        <k:title>Forstkreise und Forstreviere</k:title>
        <k:description>Die Forstkreise bilden den kantonalen Forstdienst ab. Die Forstreviere bestehen aus Waldungen einer oder mehrerer politischen Gemeinden.</k:description>
        <k:further_info_url>https://so.ch/verwaltung/volkswirtschaftsdepartement/amt-fuer-wald-jagd-und-fischerei/wald/ansprechpartner/forstkreise-und-forstreviere/</k:further_info_url>
        <k:data_owner>Amt für Wald, Jagd und Fischerei</k:data_owner>
        <k:contact>mailto:awjf@vd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="5cbef660-654f-56a2-8024-384f6f6a190d">
        <k:identifier>harvest-fruchtfolgeflaechen</k:identifier>
        <k:title>Fruchtfolgeflächen</k:title>
        <k:description>Als Fruchtfolgeflächen (FFF) werden die wertvollsten Ackerböden der Schweiz bezeichnet. Sie werden aufgrund der Geländeform, des Klimas und der Bodenbeschaffenheit bestimmt.</k:description>
        <k:further_info_url>https://so.ch/verwaltung/volkswirtschaftsdepartement/amt-fuer-landwirtschaft/boden-und-bodenrecht/fruchtfolgeflaechen-fff/</k:further_info_url>
        <k:data_owner>Amt für Landwirtschaft</k:data_owner>
        <k:contact>mailto:alw.info@vd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="ec06862f-58ae-5587-9276-ca61f001ebb8">
        <k:identifier>harvest-gebaeude-digitales-oberflaechenmodell-2018</k:identifier>
        <k:title>Gebäude digitales Oberflächenmodell (2018)</k:title>
        <k:description>Das normalisierte digitale Oberflächenmodell ist das Resultat aus der Differenzberechnung zwischen dem DOM (Rasterdaten) und DTM (Rasterdaten) und beinhaltet die Gebäude aus dem Jahr 2018 (LiDAR).</k:description>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
