      <k:Thema ili:tid="6312c155-6936-57fb-99c1-1539cf6f5fdb">
        <k:identifier>harvest-hoehenlinien-2019</k:identifier>
        <k:title>Höhenlinien (2019)</k:title>
        <k:description>Die Daten basieren auf luftgestützten Lasermessungen mit einer mittleren Punktdichte von 16 Punkten pro m2 und einer Höhengenauigkeit von 10 cm (1 Sigma=68%). 
Die Befliegung erfolgte im Frühjahr 2019.&lt;br&gt;&lt;br&gt;
Äquidistanz: 50 cm</k:description>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="2de12191-96c6-5fce-ac46-f07521f30637">
        <k:identifier>harvest-hoehenlinien-2025</k:identifier>
        <k:title>Höhenlinien (2025)</k:title>
        <k:description>Die Höhenlinien basieren auf swissALTI3D. Das Höhenmodell hat eine Rasterweite von 0.5m mit Liefer-Tiles von 1 km².</k:description>
        <k:further_info_url>https://www.swisstopo.admin.ch/de/hoehenmodell-swissalti3d</k:further_info_url>
        <k:data_owner>Bundesamt für Landestopografie swisstopo</k:data_owner>
        <k:contact>mailto:info@swisstopo.ch</k:contact>
      </k:Thema>
