      <k:Ebene ili:tid="7b95a89d-67f0-587f-9bc2-a7d97ac982df">
        <k:id>7067cc32-ac16-524d-b256-1c2f53e85624</k:id>
        <k:dtype>datasetview</k:dtype>
        <k:description>Die Kartenebene Fruchtfolgeflächen (FFF) gibt Auskunft über Lage, Umfang und Qualität der wertvollsten Ackerböden im Kanton Solothurn. Die FFF werden jährlich aufgrund verschiedener Grundlagendaten berechnet. Daten zu Klimazone, Hangneigung, Bodenqualität und Schadstoffbelastung, pflanzennutzbarer Gründigkeit und sind massgebende Kriterien.</k:description>
        <k:title>Fruchtfolgeflächen</k:title>
        <k:ident_part>ch.so.alw.fruchtfolgeflaechen</k:ident_part>
