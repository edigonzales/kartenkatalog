        <k:id>b3114049-3fcc-566f-b221-03a7f63cbe62</k:id>
        <k:dtype>datasetview</k:dtype>
        <k:description>Aufnahme der obersten Schicht von holozänen, d.h. nacheiszeitlichen Ablagerungen, z.B. Gehängeschutt oder Flussablagerungen. Die Schichten wurden nur aufgenommen, wenn sie mindestens eine Mächtigkeit von 0.5 m erreichen.</k:description>
        <k:title>Holozän (Geologie)</k:title>
        <k:ident_part>ch.so.afu.geologie.holozaen</k:ident_part>
        <k:transparency>35</k:transparency>
        <k:theme_title>Geologie</k:theme_title>
