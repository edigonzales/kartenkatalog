      <k:Thema ili:tid="5047075c-4abb-56d4-b76d-b91b8a699888">
        <k:identifier>harvest-plakatstandorte</k:identifier>
        <k:title>Plakatstandorte</k:title>
        <k:description>Die kantonale Verordnung über Abstimmungs- und Wahlplakate (BGS 113.114) regelt das Plakatieren und die Werbung bei Abstimmungen und Wahlen. Grundsätzlich ist das Aufstellen und Anbringen von Abstimmungs- und Wahlplakaten auf oder an öffentlichem Grund, der im Gemeingebrauch steht, im Rahmen der Verordnung bewilligungsfrei. Die Gemeinden können jedoch Standorte bezeichnen, an denen sie das Plakatieren erlauben oder verbieten.</k:description>
        <k:further_info_url>https://so.ch/fileadmin/internet/staatskanzlei/stk-regierungsdienste/pdf/abstimmungen-wahlen/2023/113-114_Stand_230901.pdf</k:further_info_url>
        <k:data_owner>Staatskanzlei</k:data_owner>
        <k:contact>mailto:kanzlei@sk.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="86468dda-895e-5721-bdd8-af8c993afa95">
        <k:identifier>harvest-polizeiregionen</k:identifier>
        <k:title>Polizeiregionen</k:title>
        <k:description>Die Polizei Kanton Solothurn ist in die fünf Regionen West, Mitte, Olten, Jura-Süd und Jura-Nord gegliedert.</k:description>
        <k:further_info_url>https://so.ch/verwaltung/departement-des-innern/polizei/ueber-uns/sicherheitsabteilung/regionenpolizei/</k:further_info_url>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="090f5e9c-fa31-5af0-9709-0722faceaf27">
        <k:identifier>harvest-pruefperimeter-bodenabtrag</k:identifier>
        <k:title>Prüfperimeter Bodenabtrag</k:title>
        <k:description>Flächen der potenziell schadstoffbelasteten Böden sowie bekannte Bodenbelastungsgebiete. &lt;br&gt; Mit Schadstoffen belasteter Boden, der abgetragen wird, darf nicht unkontrolliert verteilt werden. Damit belasteter Boden nicht verschleppt wird, sind die gesetzlichen Vorgaben der Abfallverordnung (VVEA; SR 814.600) sowie die Vollzugshilfe &lt;a href="https://www.bafu.admin.ch/bafu/de/home/themen/boden/publikationen-studien/publikationen/modul-verwertungseignung-von-boden.html" target="_blank"&gt;Beurteilung von Boden im Hinblick auf seine Verwertung (BAFU, 2021)&lt;/a&gt; zu beachten. 
&lt;br&gt;&lt;br&gt;
&lt;a href="https://geo.so.ch/docs/ch.so.afu.pruefperimeter_bodenabtrag/was_ist_zu_tun.pdf" target="_blank"&gt;Was ist zu tun?&lt;/a&gt;</k:description>
        <k:further_info_url>https://so.ch/verwaltung/bau-und-justizdepartement/amt-fuer-umwelt/boden-untergrund-geologie/</k:further_info_url>
        <k:data_owner>Amt für Umwelt</k:data_owner>
        <k:contact>mailto:afu@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="07ab070d-0706-5c29-89d4-3aa6a61f03a8">
        <k:identifier>harvest-quellen-ungefasst</k:identifier>
        <k:title>Quellen ungefasst</k:title>
        <k:description>Kartierung der ungefassten Quellen des Kantons. Die Quellen wurden gemäss der nationalen Methode zur Bewertung von Quell-Lebensräumen ökomorphologisch kartiert.</k:description>
        <k:data_owner>Amt für Umwelt</k:data_owner>
        <k:contact>mailto:afu@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="a9a54950-7383-5b9b-8c8f-e8831b786a31">
        <k:identifier>harvest-relief-digitales-oberflaechenmodell-2001</k:identifier>
        <k:title>Relief digitales Oberflächenmodell (2001)</k:title>
        <k:description>Beim "Relief digitales Oberflächenmodell" handelt es sich um die schattierte Abbildung der Erdoberfläche ohne Gebäuden und Vegetation.</k:description>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="de7bb7c6-fe99-50e7-a433-84ba4054a286">
        <k:identifier>harvest-relief-digitales-oberflaechenmodell-2014</k:identifier>
        <k:title>Relief digitales Oberflächenmodell (2014)</k:title>
        <k:description>Bei der Ebene Relief digitales Oberflächenmodell LiDAR (2014) handelt es sich um die schattierte Abbildung der Erdoberfläche mit Gebäuden und Vegetation.&lt;br&gt;
Die Daten basieren auf luftgestützten Lasermessungen mit einer mittleren Punktdichte von 4 Punkten pro m2 und einer Höhengenauigkeit von 15 cm (1 Sigma=68%). Die Auflösung des Reliefs beträgt 50 cm. Die Befliegung erfolgte am 14.03.14 / 17.03.14 / 3.-7.04.14</k:description>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="806e116d-f384-553f-861a-429995b0ca0b">
        <k:identifier>harvest-relief-digitales-oberflaechenmodell-2018</k:identifier>
        <k:title>Relief digitales Oberflächenmodell (2018)</k:title>
        <k:description>Bei der Ebene "Relief digitales Oberflächenmodell LiDAR  (2018)" handelt es sich um die schattierte Abbildung der Erdoberfläche mit Gebäuden und Vegetation.&lt;br&gt;
Die Daten basieren auf luftgestützten Lasermessungen mit einer mittleren Punktdichte von 16 Punkten pro m2 und einer Höhengenauigkeit von 10 cm (1 Sigma=68%). 
Die Befliegung erfolgte im Frühjahr 2018.</k:description>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
