      <k:Thema ili:tid="64082cbf-4092-5bfb-8849-4bb74958b7e1">
        <k:identifier>harvest-gebaeudeinformationen</k:identifier>
        <k:title>Gebäudeinformationen</k:title>
        <k:description>Das Thema Gebäudeinformationen beinhaltet Informationen zu Gebäuden aus der amtlichen Vermessung (inkl. Gebäudeadressen) und dem GWR.</k:description>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="ea1e94f5-58ec-531f-b35a-4b8f212d03d5">
        <k:identifier>harvest-genereller-entwaesserungsplan-gep</k:identifier>
        <k:title>Genereller Entwässerungsplan (GEP)</k:title>
        <k:description>Das Thema Genereller Entwässerungsplan (GEP) beinhaltet den Werkkataster der Siedlungsentwässerung basierend auf dem Datenmodell VSADSSMINI_2020_LV95 resp. VSADSSMINI_2020_1_LV95. Die Daten werden unregelmässig nachgeführt. Es sind nur wenige Gemeinden vorhanden. Weitere Darstellungen/Karten sind in der Informationsplattform Wasser vorhanden.</k:description>
        <k:data_owner>Amt für Umwelt</k:data_owner>
        <k:contact>mailto:afu@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="7df5fff7-0d6e-582e-a6b9-8f23b210d591">
        <k:identifier>harvest-geologie</k:identifier>
        <k:title>Geologie</k:title>
        <k:description>&lt;b&gt;Geologische GIS-Karte&lt;/b&gt;
Kantonseigene geologische GIS-Karte erstellt von 1992 bis 2001. Abweichungen zum &lt;a href="https://s.geo.admin.ch/6965030348" target="_blank"&gt;geologischen Atlas der Schweiz&lt;/a&gt; können nicht ausgeschlossen werden.</k:description>
        <k:further_info_url>https://so.ch/verwaltung/bau-und-justizdepartement/amt-fuer-umwelt/boden-untergrund-geologie</k:further_info_url>
        <k:data_owner>Amt für Umwelt</k:data_owner>
        <k:contact>mailto:afu@bd.so.ch</k:contact>
      </k:Thema>
