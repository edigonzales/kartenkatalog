      </k:Ebene>
      <k:Ebene ili:tid="aaad5896-79ea-5392-a930-dbcd8b3e18aa">
        <k:id>8809c3f2-7934-5f3a-9c70-5aeb8656f8af</k:id>
        <k:dtype>datasetview</k:dtype>
        <k:description>Durch Lösungsverwitterung entstandene Senken (Dolinen) oder Höhlen.</k:description>
