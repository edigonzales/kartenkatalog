      <k:Thema ili:tid="1ec7fec4-b283-569e-9116-50673163fd4d">
        <k:identifier>harvest-karst</k:identifier>
        <k:title>Karst</k:title>
        <k:description>Karstformationen und Karstgebiete des Kanton Solothurn gemäss den Ergebnissen der Arbeit "Karst-Grundwasser im Kanton Solothurn /Anwendung KARSYS" (SISKA 2020)</k:description>
        <k:data_owner>Amt für Umwelt</k:data_owner>
