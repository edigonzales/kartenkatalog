        <k:title>Hangneigung digitales Terrainmodell (2018)</k:title>
        <k:description>Auf Basis des DTM (Rasterdaten) wurde die Hangneigung in der Auflösung 25 cm abgeleitet. Die Neigung ist in Grad angegeben.</k:description>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="a2068938-8199-5a16-83cb-61def17ee386">
        <k:identifier>harvest-hangneigung-digitales-terrainmodell-2019</k:identifier>
        <k:title>Hangneigung digitales Terrainmodell (2019)</k:title>
        <k:description>Auf Basis des DTM (Rasterdaten) wurde die Hangneigung in der Auflösung 25 cm abgeleitet. Die Neigung ist in Grad angegeben.</k:description>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="1307b6a1-e0af-59a9-aa40-5abc7befdc6c">
        <k:identifier>harvest-hangneigung-digitales-terrainmodell-2025</k:identifier>
        <k:title>Hangneigung digitales Terrainmodell (2025)</k:title>
        <k:description>Hangneigung digitales Terrainmodell (2025) ist ein abgeleiteter Raster-Layer (Rasterdaten), der auf dem Terrainmodell swissALTI3D basiert und für jede Rasterzelle die Hangneigung (Slope, d.h. Steilheit des Geländes) berechnet liefert.</k:description>
        <k:further_info_url>https://www.swisstopo.admin.ch/de/hoehenmodell-swissalti3d</k:further_info_url>
        <k:data_owner>Bundesamt für Landestopografie swisstopo</k:data_owner>
        <k:contact>mailto:info@swisstopo.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="a0fbc1b7-45cc-54d6-b129-e6160d305436">
        <k:identifier>harvest-hochwasserschutz-emme</k:identifier>
        <k:title>Hochwasserschutz Emme</k:title>
        <k:description>Luftaufnahmen während und nach der Umsetzung des Projekts Hochwasserschutz/Revitalisierung Emme</k:description>
        <k:further_info_url>https://so.ch/verwaltung/bau-und-justizdepartement/amt-fuer-umwelt/wasserbau/hochwasserschutz-revitalisierung/hochwasserschutz-emme/</k:further_info_url>
        <k:data_owner>Amt für Umwelt</k:data_owner>
        <k:contact>mailto:afu@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="3a6ea34b-39fc-5820-9cfd-6f983d204ad1">
        <k:identifier>harvest-hoheitsgrenzen</k:identifier>
        <k:title>Hoheitsgrenzen</k:title>
        <k:description>Als Hoheitsgrenzen werden die Landesgrenzen, Kantonsgrenzen und die Grenzen der politischen Gemeinden bezeichnet. Die Hoheitsgrenzen liegen auf Grundstücksgrenzen. Sie sind Bestandteil der amtlichen Vermessung.</k:description>
        <k:further_info_url>https://so.ch/verwaltung/bau-und-justizdepartement/amt-fuer-geoinformation/amtliche-vermessung/hoheitsgrenzen/</k:further_info_url>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="e3ff62d6-c7d1-58b6-85b6-d2bd4629e2ef">
        <k:identifier>harvest-holznutzungsbewilligungen</k:identifier>
        <k:title>Holznutzungsbewilligungen</k:title>
        <k:description>Der Datensatz "Holznutzungsbewilligungen" zeigt die bewilligten Flächen für Holznutzungen gemäss Art. 21 des Schweizer Waldgesetzes. Die Daten dienen der Erfüllung der Sorgfaltspflicht nach EU-Entwaldungsverordnung (EUDR), indem sie die geforderte Geolokalisierung der Holzernteflächen, die bewilligte Erntemenge sowie die Bestätigung der rechtmässigen und waldschädigungsfreien Nutzung dokumentieren.</k:description>
        <k:further_info_url>https://so.ch/verwaltung/volkswirtschaftsdepartement/amt-fuer-wald-jagd-und-fischerei/</k:further_info_url>
        <k:data_owner>Amt für Wald, Jagd und Fischerei</k:data_owner>
        <k:contact>mailto:awjf@vd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="dc5b2bb5-3ab5-50c6-a04b-db265d6890d2">
        <k:identifier>harvest-hydrologische-einzuzgsgebiete</k:identifier>
        <k:title>Hydrologische Einzuzgsgebiete</k:title>
        <k:description>Gebiet bzw. Fläche, aus der ein Gewässersystem seinen Abfluss bezieht.</k:description>
        <k:further_info_url>https://so.ch/verwaltung/bau-und-justizdepartement/amt-fuer-umwelt/wasserbau/hydrometrie/</k:further_info_url>
        <k:data_owner>Amt für Umwelt</k:data_owner>
