      <k:Ebene ili:tid="8cfcb355-07b7-5003-b6fd-4c5898a19a64">
        <k:id>024ea747-ef05-57a0-be70-2173d9135b30</k:id>
        <k:dtype>layergroup</k:dtype>
        <k:description>Kantonseigene geologische GIS-Karte erstellt von 1992 bis 2001. Abweichungen zum &lt;a href=""https://s.geo.admin.ch/6965030348"" target=""_blank""&gt;geologischen Atlas der Schweiz&lt;/a&gt; können nicht ausgeschlossen werden.
&lt;br&gt;&lt;br&gt;Die Karte ist in drei Hauptlayer unterteilt, welche die Gesteinsschichten bis zum Tertiär, das Pleistozän und das Holozän getrennt abbilden. Somit ist das Abdecken der oberflächennah anstehenden Geologie in zwei Grosseinheiten möglich. Zudem sind weitere lithologische, stratigraphische, hydrogeologische und geotechnische Merkmale der einzelnen Gesteinseinheiten in Form von Attributen erfasst und können mittels I-Button abgefragt werden. In den Nebenlayern werden zudem Schichtfallen, Karstformen sowie tektonische Strukturen abgebildet.</k:description>
        <k:title>Geologie</k:title>
        <k:ident_part>ch.so.afu.geologie</k:ident_part>
        <k:transparency>0</k:transparency>
        <k:theme_title>Geologie</k:theme_title>
        <k:theme_ident>harvest-geologie</k:theme_ident>
        <k:Thema_R ili:ref="7df5fff7-0d6e-582e-a6b9-8f23b210d591" />
        <k:org_name>Amt für Umwelt</k:org_name>
      </k:Ebene>
      <k:Ebene ili:tid="2b32dc18-76cc-5d9f-96a3-2cdfa6d85ad9">
        <k:id>4a3fdfb8-d7c0-5dc3-bede-99ee273fbd12</k:id>
        <k:dtype>datasetview</k:dtype>
        <k:description>Layer mit Abrisskanten (plötzlicher Abbruch in der Geländeoberfläche, entstanden durch Rutschungen), ehemalige Flussrinnen, Nackentäler (durch Hangbewegungen entstandene, meist höhenlinienparallele Senken bzw. Tälchen) sowie Terrassenränder (Ränder von ehemaligen Flussterrassen).</k:description>
        <k:title>Abrisskanten (Geologie)</k:title>
        <k:ident_part>ch.so.afu.geologie.abrisskanten</k:ident_part>
        <k:transparency>0</k:transparency>
        <k:theme_title>Geologie</k:theme_title>
        <k:theme_ident>harvest-geologie</k:theme_ident>
        <k:Thema_R ili:ref="7df5fff7-0d6e-582e-a6b9-8f23b210d591" />
        <k:org_name>Amt für Umwelt</k:org_name>
      </k:Ebene>
      <k:Ebene ili:tid="c9ab0171-8238-565f-a3ef-d4f140e46b00">
        <k:id>76efc3d6-90f0-578e-a079-3c9016fad859</k:id>
        <k:dtype>datasetview</k:dtype>
        <k:description>Flächendeckende Aufnahme obersten vorhandenen Felsschicht aus der Trias, dem Jura und dem Tertiär.
Wenn keine Layer Holozän und Pleistozän darüber liegen, ist die Felsschicht an der Erdoberfläche anstehend. Ansonsten ist sie von Lockergestein überdeckt.</k:description>
        <k:title>Grundschicht (Geologie)</k:title>
        <k:ident_part>ch.so.afu.geologie.grundschicht</k:ident_part>
        <k:transparency>35</k:transparency>
        <k:theme_title>Geologie</k:theme_title>
        <k:theme_ident>harvest-geologie</k:theme_ident>
        <k:Thema_R ili:ref="7df5fff7-0d6e-582e-a6b9-8f23b210d591" />
        <k:org_name>Amt für Umwelt</k:org_name>
      </k:Ebene>
