      <k:Thema ili:tid="15f2cb02-0e9a-5f10-82d5-5baf31ef2674">
        <k:identifier>harvest-relief-digitales-terrainmodell-2014</k:identifier>
        <k:title>Relief digitales Terrainmodell (2014)</k:title>
        <k:description>Bei der Ebene Relief digitales Terrainmodel LiDAR  (2014) handelt es sich um die schattierte Abbildung der Erdoberfläche ohne Gebäuden und Vegetation.&lt;br&gt;
Die Daten basieren auf luftgestützten Lasermessungen mit einer mittleren Punktdichte von 4 Punkten pro m2 und einer Höhengenauigkeit von 15 cm (1 Sigma=68%). Die Auflösung des Reliefs beträgt 50 cm. Die Befliegung erfolgte am 14.03.14 / 17.03.14 / 3.-7.04.14</k:description>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="bf66fda6-e7da-5d60-afd3-39c3efc748ff">
