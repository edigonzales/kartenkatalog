      <k:Thema ili:tid="7e1589f5-3008-5c0f-8a89-db7241da66c9">
        <k:identifier>harvest-gewaesserschutz</k:identifier>
        <k:title>Gewässerschutz</k:title>
        <k:description>Das Thema  Gewässerschutz umfasst die Gewässerschutzbereiche, die Grundwasserschutzzonen und -areale sowie die Zuströmbereiche gemäss GschG und GSchV.</k:description>
        <k:further_info_url>https://so.ch/verwaltung/bau-und-justizdepartement/amt-fuer-umwelt/wasser/</k:further_info_url>
        <k:data_owner>Amt für Umwelt</k:data_owner>
        <k:contact>mailto:afu@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="e0047be9-4c8e-5a3d-bc65-d0e484be00de">
        <k:identifier>harvest-grundwasserbewirtschaftung</k:identifier>
        <k:title>Grundwasserbewirtschaftung</k:title>
        <k:description>Das Thema Grundwasserbewirtschaftung zeigt die Standorte der Trinkwasserversorgung (Quellen und Fassungen), der Grundwasserwärmenutzung, Sondierungen und der Einbauten ins Grundwasser auf.</k:description>
        <k:further_info_url>https://so.ch/verwaltung/bau-und-justizdepartement/amt-fuer-umwelt/wasser/</k:further_info_url>
        <k:data_owner>Amt für Umwelt</k:data_owner>
        <k:contact>mailto:afu@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="f156a156-506d-5a55-a319-580e6da74ad4">
        <k:identifier>harvest-grundwassergeometrie</k:identifier>
        <k:title>Grundwassergeometrie</k:title>
        <k:description>Umfasst Angaben zur Grundwassermächtigkeit und zur Grundwasserausdehnung.</k:description>
        <k:further_info_url>https://so.ch/verwaltung/bau-und-justizdepartement/amt-fuer-umwelt/wasser</k:further_info_url>
        <k:data_owner>Amt für Umwelt</k:data_owner>
        <k:contact>mailto:afu@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="f4a41601-9cfc-5942-b301-328b869c908a">
        <k:identifier>harvest-hanglagen</k:identifier>
        <k:title>Hanglagen</k:title>
        <k:description>Der Datensatz Hanglagen ist Teil der Grundlagen zur Berechnung der landwirtschaftlichen Direktzahlungen. Er wurde gesamtschweizerisch einheitlich berechnet. Folgende Hangneigungsklassen wurden unterschieden: &lt;18; 18-35; 35-50; &gt;50 Prozent.</k:description>
        <k:data_owner>Amt für Landwirtschaft</k:data_owner>
        <k:contact>mailto:alw.info@vd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="a32c3daf-1736-5a0d-82d6-3beaa49d9d8e">
        <k:identifier>harvest-hangneigung-digitales-terrainmodell-2001</k:identifier>
        <k:title>Hangneigung digitales Terrainmodell (2001)</k:title>
        <k:description>Auf Basis des DTM (Rasterdaten) wurde die Hangneigung abgeleitet. Die Neigung ist in Grad angegeben.</k:description>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
        <k:contact>mailto:agi@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="3b5058e4-4c4c-521f-aefc-f2b28ad87e72">
