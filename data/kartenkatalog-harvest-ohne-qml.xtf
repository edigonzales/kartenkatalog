      <k:Thema ili:tid="ace82b81-00b4-5789-bce0-0550aa38a9ee">
        <k:identifier>harvest-agglomerationsprogramme</k:identifier>
        <k:title>Agglomerationsprogramme</k:title>
        <k:description>Mit dem Programm Agglomerationsverkehr (PAV) beteiligt sich der Bund finanziell an Verkehrsprojekten von Städten und Agglomerationen. Von Bundesbeiträgen profitieren Agglomerationen, die mit ihren Agglomerationsprogrammen die Verkehr- und Siedlungsentwicklung wirkungsvoll aufeinander abstimmen. Der Kanton Solothurn ist an den Agglomerationsprogrammen AareLand, Grenchen, Basel und Solothurn beteiligt.</k:description>
        <k:further_info_url>https://www.are.admin.ch/are/de/home/mobilitaet/programme-und-projekte/pav.html</k:further_info_url>
        <k:data_owner>Amt für Raumplanung</k:data_owner>
        <k:contact>mailto:arp@bd.so.ch</k:contact>
      </k:Thema>
      <k:Thema ili:tid="6509bad5-3be7-53cd-baab-80ab8a2faa23">
        <k:identifier>harvest-amtliche-vermessung-darstellung-grundbuchplan</k:identifier>
        <k:title>Amtliche Vermessung (Darstellung Grundbuchplan)</k:title>
        <k:description>Thema für das Vorhalten speziell aufbereiteter AV-Daten zwecks korrekter Darstellung des Planes für das Grundbuch.</k:description>
        <k:data_owner>Amt für Geoinformation</k:data_owner>
